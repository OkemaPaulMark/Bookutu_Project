# Passenger web app. Same-origin API: the browser calls /api/... on this
# domain and Caddy forwards it to the backend over Railway's private network.
{
	admin off
	servers {
		trusted_proxies static private_ranges 100.64.0.0/10
	}
}

:{$PORT:8080} {
	encode gzip zstd

	@backend path /api/* /media/*
	handle @backend {
		reverse_proxy {$BACKEND_URL} {
			# Keep the public Host and the scheme set by Railway's edge (https),
			# so the backend builds correct absolute URLs for images.
			header_up Host {hostport}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
		}
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		root * /srv
		try_files {path} /index.html
		@static path *.js *.wasm *.png *.jpg *.jpeg *.otf *.ttf *.json
		header @static Cache-Control "public, max-age=3600"
		header /index.html Cache-Control "no-cache"
		header /flutter_service_worker.js Cache-Control "no-cache"
		file_server
	}
}
