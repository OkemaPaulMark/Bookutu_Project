          "name": "Cancel Booking",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/bookings/:id/cancel",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
