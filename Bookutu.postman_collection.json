{
  "info": {
    "name": "Bookutu API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:4000/api/v1" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "http://localhost:4000/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Bootstrap Super Admin",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/bootstrap-super-admin",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bookutu.com\",\n  \"firstName\": \"Super\",\n  \"lastName\": \"Admin\",\n  \"phoneNumber\": \"+256700000000\",\n  \"password\": \"Admin@1234\",\n  \"confirmPassword\": \"Admin@1234\"\n}"
            }
          }
        },
        {
          "name": "Register Passenger",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"passenger@example.com\",\n  \"username\": \"johndoe\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phoneNumber\": \"+256711000000\",\n  \"password\": \"Pass@1234\",\n  \"confirmPassword\": \"Pass@1234\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access) pm.collectionVariables.set('access_token', res.access);",
                  "if (res.refresh) pm.collectionVariables.set('refresh_token', res.refresh);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bookutu.com\",\n  \"password\": \"Admin@1234\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access) pm.collectionVariables.set('access_token', res.access);",
                  "if (res.refresh) pm.collectionVariables.set('refresh_token', res.refresh);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/logout",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Get Password Setup Details",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/password-setup/:token",
            "header": []
          }
        },
        {
          "name": "Set Password",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/set-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<password_setup_token>\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Staff\",\n  \"phoneNumber\": \"+256722000000\",\n  \"password\": \"Staff@1234\",\n  \"confirmPassword\": \"Staff@1234\"\n}"
            }
          }
        },
        {
          "name": "Invite Company Staff (Super Admin)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register/staff",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@buscompany.com\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Staff\",\n  \"phoneNumber\": \"+256722000000\",\n  \"companyId\": \"<company_id>\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "List Companies",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/companies?page=1&limit=20",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Get Company",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/companies/:id",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Create Company (Super Admin)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/companies",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kampala Express\",\n  \"email\": \"info@kampalaexpress.com\",\n  \"phoneNumber\": \"+256700111222\",\n  \"address\": \"Plot 12, Kampala Road\",\n  \"city\": \"Kampala\",\n  \"state\": \"Central\",\n  \"country\": \"Uganda\",\n  \"registrationNumber\": \"REG-2024-001\",\n  \"licenseNumber\": \"LIC-2024-001\"\n}"
            }
          }
        },
        {
          "name": "Update Company",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/companies/:id",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\",\n  \"description\": \"Premium bus services across Uganda\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Fleet",
      "item": [
