              "raw": "{\n  \"tripId\": \"<trip_id>\",\n  \"seatId\": \"<seat_id>\",\n  \"passengerName\": \"John Doe\",\n  \"passengerPhone\": \"+256711000000\",\n  \"passengerEmail\": \"john@example.com\"\n}"
            }
          }
        },
